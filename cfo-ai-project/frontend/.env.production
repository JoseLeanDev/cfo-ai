# El backend de cfo-ai sirve este frontend desde su propio proceso: /api es
# siempre mismo origen. En desarrollo Vite hace proxy (ver vite.config.js).
VITE_API_URL=/api

# Moneda y umbrales financieros
VITE_MONEDA_DEFAULT=GTQ
VITE_TIPO_CAMBIO=7.75
VITE_UMBRAL_SALDO_CRITICO=1000000
VITE_UMBRAL_SALDO_ADVERTENCIA=2000000
VITE_PROYECCION_SEMANAS=12
VITE_CONCENTRACION_CLIENTE_CRITICO=0.20

# Identidad del cliente mostrada en el shell
VITE_CLIENTE_NOMBRE=Grupo Retail Centroamérica
VITE_CLIENTE_REGION=Centroamérica
